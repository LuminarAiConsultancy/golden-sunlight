# Elevation data. Roughly 104 MB across four tiles, downloaded automatically on
# first run and cached here. Freely re-downloadable, so it does not belong in
# version control. See the README for the download size and time.
dem/

# Python caches and compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Office lock files, written while a document is open
~$*.docx
~$*.xlsx

# Archives and duplicates, kept out deliberately
*.zip
* - Copy.*
